header 
    //-manera de llamar clase div.navegación(.navegacion crea div por defecto)
    div(class='navegacion')
        .container
            .row.justify-content-center.justify-content-md-between.align-items-center.py-4
                .col-md-4.col-6
                    a(href="/") 
                        img(src="/img/logo.svg", alt="logo")
                .col-md-8.col-4
                    nav.mt-5.mt-md-0.d-flex.justify-content-center.justify-content-end 
                        a.nav-link(href="/nosotros") Nosotros 
                        a.nav-link(href="/viajes") Viajes
                        a.nav-link(href="/testimonios") Testimoniales

